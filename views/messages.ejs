<% include ./partials/header.ejs %>

<div class="w-full min-h-screen bg-zinc-900 text-white py-5">
    <!-- Header -->
    <div class="w-full px-4 flex items-center justify-start">
        <a href="/feed">
            <i class="ri-arrow-left-line text-2xl text-white"></i>
        </a>
        <h1 class="w-1/4 ml-14 text-lg"><%= user.username || 'User' %></h1>
    </div>

    <!-- Search Box -->
    <div class="mt-6 border-2 border-zinc-800 flex items-center justify-between px-3 py-1 rounded-md">
        <i class="text-white ri-search-line"></i>
        <input id="inputusername" 
               class="ml-1 w-full bg-zinc-900 outline-none text-zinc-400 placeholder-zinc-500" 
               type="text" 
               placeholder="Search username">
    </div>

    <!-- Search Results -->
    <div id="searchResults" class="mt-3 px-3"></div>

    <!-- Story Section -->
    <div class="mt-6 story px-3 flex gap-3 overflow-auto">
        <!-- Logged-in user circle -->
        <div class="circle flex-shrink-0">
            <div class="gradient w-[18vw] h-[18vw] rounded-full bg-gradient-to-r from-blue-500 to-green-500 flex items-center justify-center">
                <div class="inner w-[92%] h-[92%] rounded-full overflow-hidden">
                    <img class="w-full h-full object-cover"
                         src="<%= user.profilePicture || '/images/default-avatar.png' %>" 
                         alt="<%= user.username || 'Me' %>">
                </div>
            </div>
        </div>

        <!-- Following users circles -->
        <% if (user.following && user.following.length > 0) { %>
            <% user.following.forEach(follow => { %>
                <div class="circle flex-shrink-0">
                    <div class="gradient w-[18vw] h-[18vw] rounded-full bg-gradient-to-r from-purple-700 to-orange-500 flex items-center justify-center">
                        <div class="inner w-[92%] h-[92%] rounded-full overflow-hidden">
                            <img class="w-full h-full object-cover"
                                 src="<%= follow.profilePicture || '/images/default-avatar.png' %>" 
                                 alt="<%= follow.username || 'User' %>">
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <p class="text-gray-400">You are not following anyone yet.</p>
        <% } %>
    </div>

    <!-- Tabs -->
    <div class="w-full px-4 flex items-center justify-between">
        <div class="text-white mt-6 text-lg ml-1 font-semibold">Messages</div>
        <div class="text-gray-400 mt-6 text-lg mr-1">Requests</div>
    </div>

    <!-- Message List -->
    <% if (recentMessages && recentMessages.length > 0) { 
        let uniqueChats = {};
        recentMessages.forEach(msg => {
            if (!msg.sender || !msg.receiver) return;
            let chatUser = msg.sender._id.toString() === user._id.toString() ? msg.receiver : msg.sender;
            if (!uniqueChats[chatUser._id]) {
                uniqueChats[chatUser._id] = { user: chatUser, lastMsg: msg };
            }
        });
        Object.values(uniqueChats).forEach(chat => {
    %>
        <a href="/chatsection/<%= chat.user._id %>" class="outline-none block">
            <div class="ml-3 text-white flex items-center gap-2 mt-5">
                <div class="image w-[11vw] h-[11vw] rounded-full overflow-hidden">
                    <img src="<%= chat.user.profilePicture || '/images/default-avatar.png' %>" 
                         alt="<%= chat.user.username || 'User' %>">
                </div>
                <div class="text">
                    <h3><%= chat.user.username || 'User' %></h3>
                    <h4 class="text-xs opacity-30 leading-none">
                        <%= chat.lastMsg.updatedAt ? new Date(chat.lastMsg.updatedAt).toLocaleString() : '' %>
                    </h4>
                </div>
            </div>  
        </a>
    <% }) %>
    <% } else { %>
        <p class="text-center text-gray-400 mt-10">No messages yet</p>
    <% } %>
</div>

<!-- Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.6.7/axios.min.js"></script>

<script>
  const input = document.getElementById("inputusername");
  const resultsDiv = document.getElementById("searchResults");

  input.addEventListener("keyup", async (e) => {
    const query = e.target.value.trim();

    if (query.length === 0) {
      resultsDiv.innerHTML = "";
      return;
    }

    try {
    const res = await axios.get(`/search?username=${query}`);
const users = Array.isArray(res.data) ? res.data : []; // ✅ ensure array

if (users.length === 0) {
  resultsDiv.innerHTML = `<p class="text-gray-400">No users found</p>`;
  return;
}

      resultsDiv.innerHTML = users.map(user => `
        <a href="/chatsection/${user._id}" class="flex items-center gap-2 py-2 border-b border-zinc-800">
          <img src="${user.profilePicture || '/images/default-avatar.png'}" 
               class="w-10 h-10 rounded-full">
          <span>${user.username}</span>
        </a>
      `).join("");

    } catch (err) {
      console.error("❌ Error searching:", err);
    }
  });
</script>


<% include ./partials/footer.ejs %>
