<% include ./partials/header.ejs %>
<link
    href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css"
    rel="stylesheet"
/>

<div class="w-full min-h-screen bg-zinc-900 text-white py-5">
    <!-- Back Button (Only for other user's profile) -->
    <% if(user._id.toString() !== loggedInUser._id.toString()) { %>
        <div class="absolute top-0 left-1">
            <button 
                onclick="window.history.back()" 
                class="flex items-center justify-center w-10 h-10 bg-black bg-opacity-30 text-white rounded-full hover:bg-opacity-50 transition">
                <i class="ri-arrow-left-line text-xl"></i>
            </button>
        </div>
    <% } %>

    <!-- Navigation -->
    <div class="nav flex justify-between items-center px-4">
        <h3 class="text-lg"><%= user.username %></h3>
        <div class="icons flex gap-5">
            <a href="/upload"><i class="text-[1.4rem] ri-add-box-line"></i></a>
            <i class="text-[1.4rem] ri-menu-line"></i>
        </div>
    </div>

    <!-- Profile Info -->
    <div class="flex justify-between items-center pl-6 pr-[12vw] mt-2">
        <div class="w-[19vw] h-[19vw] bg-sky-100 rounded-full overflow-hidden">
            <img class="w-full h-full object-cover" src="/images/uploads/<%= user.profileImage %>" alt="">
        </div>
        <div class="stats flex gap-5 items-center justify-between">
            <div class="flex flex-col items-center justify-center">
                <h3 id="postsCount"><%= user.posts.length %></h3>
                <h4>Posts</h4>
            </div>
            <div class="flex flex-col items-center justify-center">
                <h3 id="followersCount"><%= user.followers.length %></h3>
                <h4>Followers</h4>
            </div>
            <div class="flex flex-col items-center justify-center">
                <h3 id="followingCount"><%= user.following.length %></h3>
                <h4>Following</h4>
            </div>
        </div>
    </div>

    <!-- User Details -->
    <div class="dets px-6 mt-5">
        <h3 class="text-lg mb-1"><%= user.name %></h3>
        <p class="text-xs tracking-tight opacity-50">
            <%= user.Bio ?? 'Set your profile bio' %>
        </p>
    </div>

    <!-- Edit / Follow & Message -->
    <div class="px-6 mt-5">
        <% if(user._id.toString() === loggedInUser._id.toString()) { %>
            <!-- Own Profile -->
            <a class="px-3 py-2 bg-zinc-800 text-xs rounded-md" href="/edit">Edit Profile</a>
        <% } else { %>
            <!-- Someone else's profile -->
            <button id="followBtn" class="px-3 py-2 <%= loggedInUser.following.includes(user._id.toString()) ? 'bg-blue-600' : 'bg-gray-600' %> text-xs rounded-md">
                <%= loggedInUser.following.includes(user._id.toString()) ? 'Following' : 'Follow' %>
            </button>
            <a href="/message/<%= user._id %>" class="px-3 py-2 bg-green-600 text-xs rounded-md ml-2">Message</a>
        <% } %>
    </div>

    <!-- Profile Tabs -->
    <div class="px-6 mt-5 flex gap-5 text-2xl">
        <a href="/profile"><i class="ri-grid-fill"></i></a>
        <a href="/saved"><i class="ri-bookmark-line"></i></a>
    </div>

    <!-- Posts -->
    <div class="posts w-full flex gap-1 py-2 mt-5 flex-wrap">
        <% user.posts.forEach(function(post){ %>
            <div class="post w-[32.5%] h-32 bg-sky-100 overflow-hidden">
                <% const videoExtensions = ['mp4', 'webm', 'ogg']; %>
                <% if (post.media) { %>
                    <% const fileExtension = post.media.split('.').pop().toLowerCase(); %>
                    <% if (videoExtensions.includes(fileExtension)) { %>
                        <video class="imge w-full h-full object-cover" autoplay muted loop>
                            <source src="/images/uploads/<%= post.media %>" type="video/<%= fileExtension %>">
                        </video>
                    <% } else { %>
                        <img data-id="<%= post._id %>" class="imge w-full h-full object-cover" src="/images/uploads/<%= post.media %>" alt="">
                    <% } %>
                <% } else { %>
                    <p class="text-center text-sm text-gray-500">No media available</p>
                <% } %>
            </div>
        <% }) %>
    </div>
</div>

<% include ./partials/footer.ejs %>

<script>
const followBtn = document.getElementById('followBtn');
const followersCount = document.getElementById('followersCount');
const followingCount = document.getElementById('followingCount');

if (followBtn) {
    followBtn.addEventListener('click', async () => {
        try {
            const response = await fetch('/follow/<%= user._id %>', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            const data = await response.json();

            if (data.status === 'followed') {
                followBtn.textContent = 'Following';
                followBtn.classList.remove('bg-gray-600');
                followBtn.classList.add('bg-blue-600');
            } else if (data.status === 'unfollowed') {
                followBtn.textContent = 'Follow';
                followBtn.classList.remove('bg-blue-600');
                followBtn.classList.add('bg-gray-600');
            }

            // Update follower/following counts dynamically
            followersCount.textContent = data.followersCount;
            followingCount.textContent = data.followingCount;

        } catch (err) {
            console.error(err);
        }
    });
}
</script>
