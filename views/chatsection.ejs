<% include ./partials/header.ejs %>

<div class="w-full min-h-screen bg-zinc-900 text-white py-5">
  <!-- Header -->
  <div class="w-full px-4 flex items-center justify-start border-white">
    <a href="/message">
      <i class="ri-arrow-left-line text-2xl text-white"></i>
    </a>
    <div class="ml-6 text-white flex items-center gap-2 mt-1">
      <div class="image w-[11vw] h-[11vw] rounded-full overflow-hidden">
        <img src="<%= otherUser.profilePicture %>" alt="<%= otherUser.username %>">
      </div>
      <div class="text">
        <h3><%= otherUser.username %></h3>
        <h4 class="text-xs opacity-30 leading-none">Active</h4>
      </div>
    </div>
  </div>

  <!-- Messages Container -->
  <ul id="messages" class="mt-6 px-4 space-y-2 max-h-[70vh] overflow-y-auto"></ul>

  <!-- Input Box -->
  <div class="fixed bottom-0 w-full px-4 py-2 bg-zinc-900 flex gap-2">
    <input id="input" class="flex-1 text-black px-3 py-2 rounded" type="text" placeholder="Type a message..." autocomplete="off">
    <button id="sendBtn" class="bg-blue-600 px-4 py-2 rounded text-white">Send</button>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.6.7/axios.min.js"></script>
<script>
  const socket = io();
  const messagesContainer = document.getElementById('messages');
  const input = document.getElementById('input');
  const sendBtn = document.getElementById('sendBtn');

  const otherUserId = "<%= otherUser._id %>";
  const currentUserId = "<%= currentUser._id %>";

  // Load previous messages
  async function loadMessages(id) {
    try {
      const res = await axios.get(`/message/${id}`);
      messagesContainer.innerHTML = "";
      res.data.forEach(msg => {
        const item = document.createElement('li');
        item.textContent = `${msg.sender.username}: ${msg.text}`;
        messagesContainer.appendChild(item);
      });
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    } catch (err) {
      console.error("Error loading messages", err);
      messagesContainer.innerHTML = "<li style='color:red'>Failed to load messages.</li>";
    }
  }

  loadMessages(otherUserId);

  // Send message
  async function sendMessage() {
    const text = input.value.trim();
    if (!text) return;
    input.value = '';

    try {
      const res = await axios.post('/message/send', {
        receiverId: otherUserId,
        text
      });

      const msg = res.data;
      appendMessage(msg);
      socket.emit('chat message', msg);
    } catch (err) {
      console.error("Failed to send message", err);
    }
  }

  // Append message helper
  function appendMessage(msg) {
    const item = document.createElement('li');
    item.textContent = `${msg.sender.username}: ${msg.text}`;
    messagesContainer.appendChild(item);
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  }

  // Enter key
  input.addEventListener('keypress', e => { if(e.key === 'Enter') sendMessage(); });
  // Send button
  sendBtn.addEventListener('click', sendMessage);

  // Receive socket messages
  socket.on('chat message', function(msg) {
    if (msg.sender._id !== currentUserId) {
      appendMessage(msg);
    }
  });
</script>

<% include ./partials/footer.ejs %>
