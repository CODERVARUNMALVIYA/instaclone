<!DOCTYPE html>
<html>
<head>
  <title><%= user.username %> ki Stories</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: black;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      overflow: hidden;
      font-family: Arial, sans-serif;
      color: white;
    }
    .story-container {
      position: relative;
      width: 100%;
      height: 100vh;
      background-color: black;
    }
    .story-header {
      position: absolute;
      top: 10px;
      left: 15px;
      font-weight: bold;
      font-size: 18px;
      z-index: 10;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .story-header img {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 2px solid white;
    }
    .story-media {
      width: 100%;
      height: 100vh;
      object-fit: cover;
    }
    .close-btn {
      position: absolute;
      top: 10px;
      right: 15px;
      color: white;
      font-size: 24px;
      cursor: pointer;
      z-index: 10;
      background: rgba(0,0,0,0.5);
      padding: 5px 10px;
      border-radius: 50%;
    }
    .nav {
      position: absolute;
      top: 0;
      width: 50%;
      height: 100%;
      cursor: pointer;
      z-index: 5;
    }
    .nav-left {
      left: 0;
    }
    .nav-right {
      right: 0;
    }
  </style>
</head>
<body>
  <div class="story-container">
    <!-- Close Button -->
    <div class="close-btn" onclick="window.history.back()">&#10005;</div>

    <!-- Username + profile -->
    <div class="story-header">
      <img src="<%= user.profilePic %>" alt="profile">
      <span><%= user.username %></span>
    </div>

    <!-- Left & Right navigation areas -->
    <div class="nav nav-left" onclick="prevStory()"></div>
    <div class="nav nav-right" onclick="nextStory()"></div>

    <!-- Media -->
    <div id="storyContent"></div>

    <!-- Hidden div to store EJS data -->
    <div id="storyData" data-stories='<%- JSON.stringify(stories) %>'></div>
  </div>

  <script>
    // Get stories from hidden div
    const stories = JSON.parse(document.getElementById("storyData").dataset.stories);
    let currentIndex = 0;

    function showStory(index) {
      const story = stories[index];
      let html = "";
      if (story.mediaType === "image") {
        html = `<img src="/uploads/${story.media}" class="story-media">`;
      } else {
        html = `
          <video autoplay muted controls class="story-media">
            <source src="/uploads/${story.media}" type="video/mp4">
          </video>
        `;
      }
      document.getElementById("storyContent").innerHTML = html;
    }

    function nextStory() {
      if (currentIndex < stories.length - 1) {
        currentIndex++;
        showStory(currentIndex);
      } else {
        window.history.back(); // Exit if no more stories
      }
    }

    function prevStory() {
      if (currentIndex > 0) {
        currentIndex--;
        showStory(currentIndex);
      }
    }

    // Auto move to next story after 5s for images
    setInterval(() => {
      const story = stories[currentIndex];
      if (story.mediaType === "image") {
        nextStory();
      }
    }, 5000);

    // Initial load
    showStory(currentIndex);
  </script>
</body>
</html>
